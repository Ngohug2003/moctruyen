{
  "expo": {
    "name": "Mộc · Đọc truyện v1.0.9",
    "slug": "moctruyen",
    "version": "1.0.9",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F2EB",
    "android": {
      "package": "com.hungnv.mocreader",
      "versionCode": 1,
      "icon": "./assets/brand/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#234B38"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#F5F2EB",
          "dark": {
            "image": "./assets/brand/logo-dark.png",
            "backgroundColor": "#151D1A"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "./plugins/with-local-api.cjs"
    ],
    "assetBundlePatterns": ["assets/**/*"],
    "owner": "viethung111003s-team",
    "extra": {
      "eas": {
        "projectId": "db746cc1-15a8-4af4-907d-85223d4beb70"
      }
    },
    "icon": "./assets/brand/icon.png",
    "ios": {
      "icon": "./assets/brand/icon.png"
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    }
  }
}
