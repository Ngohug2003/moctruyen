{
  "cli": {
    "version": "25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "24.16.0",
      "developmentClient": false,
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://moctruyen.onrender.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "node": "24.16.0",
      "environment": "production",
      "autoIncrement": true
    }
  }
}
