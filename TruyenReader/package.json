{
  "name": "truyen-reader",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/content/prepare-book.mjs && expo start",
    "android": "node scripts/content/prepare-book.mjs && expo run:android",
    "prepare:book": "node scripts/content/prepare-book.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:apk": "node scripts/build/build-apk.mjs",
    "build:local": "node scripts/build/validate-native.mjs && node scripts/content/prepare-book.mjs --require-input && expo prebuild --platform android && node scripts/build/build-local.mjs",
    "verify:android": "expo export --platform android --output-dir build-check",
    "eas-build-post-install": "node scripts/build/validate-native.mjs && node scripts/content/verify-bundle.mjs",
    "native:check": "node scripts/build/validate-native.mjs",
    "build:check": "node scripts/build/build-apk.mjs --check-only",
    "apk:download": "node scripts/build/download-apk.mjs",
    "brand:generate": "node scripts/brand/create-brand.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check && npm run check && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@types/react": "~19.2.4",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "eas-cli": "25.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5"
  }
}
