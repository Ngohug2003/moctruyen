{
  "name": "moc-truyen-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-books.mjs && vite",
    "prepare:books": "node scripts/prepare-books.mjs",
    "build": "node scripts/prepare-books.mjs && tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "check": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "preview": "vite preview",
    "validate": "npm run lint && npm run format:check && npm run check && npm test",
    "test:auth": "node tests/auth-browser.mjs",
    "test:cultivation": "node tests/cultivation-browser.mjs",
    "test:local": "node tests/local-reading-browser.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
